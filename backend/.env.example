# 银发守护 Silver Guardian v2.0 环境配置
# 复制此文件为 .env 并编辑

# ============================================================
# LLM Provider（选择一个）
# ============================================================
LLM_PROVIDER=agnes

# Agnes AI（默认）
AGNES_API_KEY=sk-your-key-here
AGNES_API_BASE=https://api.agnes.ai/v1

# 通义千问（备选）
# LLM_PROVIDER=qwen
# QWEN_API_KEY=sk-your-key
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI（备选）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key

# DeepSeek（备选）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key

# ============================================================
# RAG — 健康知识库
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# 🆕 个人知识库 (my-wiki)
# ============================================================
# BM25 模式（默认，零依赖）或 ollama 向量模式
MYWIKI_RAG_MODE=bm25
# MYWIKI_OLLAMA_URL=http://localhost:11434

# ============================================================
# 语音
# ============================================================
TTS_SPEED=0.8
TTS_VOLUME=1.2
TTS_PROVIDER=edge

# ============================================================
# 服务
# ============================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000
